# RAG service. Copy to .env and fill HiHub credentials.
# Do not commit or share the resulting .env.

# gRPC service endpoint.
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
GRPC_MAX_CONCURRENT_QUERIES=1
# Current LLM client is one-pass; token chunks are emitted after generation,
# followed by the mandatory FinalResult.
GRPC_STREAM_TOKENS=true
GRPC_TOKEN_CHUNK_CHARS=48
GRPC_HEALTH_LLM_TIMEOUT_SECONDS=1.5
GRPC_MAX_SYNC_JOBS=100

AUTO_BUILD_INDEX=true
HIHUB_BASE_URL=https://hihub.ru
HIHUB_EMAIL=
HIHUB_PASSWORD=
HIHUB_TOKEN_NAME=
HIHUB_SECTION_ID=0
HIHUB_TIMEOUT_SECONDS=120
HIHUB_PER_PAGE=200
HIHUB_MAX_ARTICLES=0
INDEX_DIR=data/index

# Chunking / retrieval
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=180
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSION=768
DENSE_TOP_K=60
SPARSE_TOP_K=80
RERANK_CANDIDATE_K=80
RERANKER_BACKEND=rrf
MAX_CHUNKS_PER_DOCUMENT=3
OPTIMIZED_RETRIEVAL_TOP_K=10
LEXICAL_RERANK_ENABLED=true
LEXICAL_CANDIDATE_K=80
LEXICAL_COVERAGE_WEIGHT=0.42
LEXICAL_TITLE_WEIGHT=0.16
LEXICAL_PROXIMITY_WEIGHT=0.10
LEXICAL_DOCUMENT_WEIGHT=0.10
NEIGHBOR_EXPANSION_ENABLED=true
NEIGHBOR_DISTANCE=1
NEIGHBOR_ANCHOR_K=3
RETRIEVAL_MIN_SCORE=0.0

# Focused context
FOCUSED_PASSAGES_ENABLED=true
FOCUSED_PASSAGE_CHARS=420
FOCUSED_PASSAGE_NEIGHBOR_SENTENCES=1
MAX_CONTEXT_CHARS=1500
CONTEXT_MAX_CHUNKS=3
CONTEXT_DUPLICATE_JACCARD=0.88

# llama.cpp / Qwen3
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=local
LLM_MODEL=qwen3-4b-rag
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_MIN_P=0
LLM_PRESENCE_PENALTY=0
LLM_REPEAT_PENALTY=1.05
LLM_CACHE_PROMPT=true
LLM_CACHE_REUSE=64
LLM_SERVER_PREDICT_BUDGET_MS=17500
LLM_ADAPTIVE_TOKENS=true
LLM_FACT_MAX_TOKENS=52
LLM_DEFAULT_MAX_TOKENS=68
LLM_PROCEDURE_MAX_TOKENS=82
LLM_MIN_ANSWER_TOKENS=32
LLM_DECODE_MARGIN_SECONDS=1.8
LLM_PERF_EMA_ALPHA=0.35
LLM_INITIAL_PROMPT_TPS=60
LLM_INITIAL_DECODE_TPS=10
LLM_INPUT_TOKEN_COUNT_ENABLED=true
LLM_PROMPT_BUDGET_SAFETY=0.88
LLM_MAX_TOKENS=220
NAIVE_MAX_TOKENS=82
QWEN_NO_THINK=true
LLM_TIMEOUT_SECONDS=20
LLM_CONNECT_TIMEOUT_SECONDS=2
LLM_MAX_RETRIES=0
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT_SECONDS=8

# Quality / SLA
LATENCY_OPTIMIZED_MODE=true
REQUEST_DEADLINE_SECONDS=23.5
LLM_RESPONSE_BUDGET_SECONDS=20
EXTRACTIVE_FALLBACK_ENABLED=true
EXTRACTIVE_MIN_SCORE=0.42
ANSWER_CACHE_SIZE=128
FAST_NAIVE_ENABLED=true
LEGACY_NAIVE_FALLBACK_ENABLED=false
NAIVE_CONTEXT_TOP_K=5
VALIDATION_MODE=off
QUALITY_GATE_ENABLED=true
QUALITY_GATE_DIRECT_QUERIES_ENABLED=true
QUALITY_GATE_EXTERNAL_INTENTS_ENABLED=true
QUALITY_GATE_CLARIFY_GENERIC_ENABLED=true
QUALITY_GATE_WEAK_THRESHOLD=0.42
QUALITY_GATE_STRONG_THRESHOLD=0.62
QUALITY_GROUNDING_GUARD_ENABLED=true
QUALITY_ANSWER_RELEVANCE_GUARD_ENABLED=true
QUALITY_PROCEDURE_SOURCE_COHERENCE=true
